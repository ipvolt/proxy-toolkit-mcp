# BEGIN IPVOLT MCP MANAGED
mcp.ipvolt.com {
    # Task541: HTTPS persistence for this hostname only. No subdomains/preload.
    header Strict-Transport-Security "max-age=86400"
    # Request arguments, diagnostic nonces and visitor addresses are not access logs.
    log_skip
    header X-Robots-Tag "noindex, nofollow"
    header X-Content-Type-Options "nosniff"
    request_body {
        max_size 32768
    }
    @public_mcp path /mcp /egress
    handle @public_mcp {
        reverse_proxy 127.0.0.1:3040 {
            # This is the actual socket peer, independent of forwarded headers.
            header_up X-IPVolt-Peer {http.request.remote.host}
            header_up -Forwarded
            header_up -X-Real-IP
            header_up -X-Forwarded-For
            transport http {
                dial_timeout 2s
                response_header_timeout 12s
                read_timeout 12s
                write_timeout 12s
                max_response_header 16384
                compression off
            }
        }
    }
    # The crawl policy for this hostname. It serves protocol endpoints, not pages, so this is the only other path.
    handle /robots.txt {
        respond <<ROBOTS
            # robots.txt for https://mcp.ipvolt.com
            #
            # ipvolt's Proxy Toolkit MCP server (/mcp). It has no pages; the documentation is at https://ipvolt.com/mcp.
            # Crawl policy as on https://ipvolt.com/robots.txt: every crawler is welcome, AI crawlers included.
            # Content Signals: https://contentsignals.org/

            User-agent: *
            Content-Signal: search=yes, ai-input=yes, ai-train=yes
            Allow: /

            ROBOTS 200
    }
    handle {
        respond "Not found" 404
    }
    handle_errors {
        respond "Request could not be completed" {err.status_code}
    }
}
# END IPVOLT MCP MANAGED
